DATABASE_URL=sqlite:///./life_debug.db
# Life Debug Supabase project (public identity-provider configuration).
# Requires an asymmetric RS256/ES256 signing key; legacy HS256 is unsupported.
AUTH_ISSUER=https://bbrdiakvwocjblbymuyj.supabase.co/auth/v1
AUTH_JWKS_URL=https://bbrdiakvwocjblbymuyj.supabase.co/auth/v1/.well-known/jwks.json
AUTH_AUDIENCE=authenticated
# Future PostgreSQL: postgresql+psycopg://user:password@localhost:5432/life_debug

# Optional, on-demand Gemini reflections. Keep the real key ONLY in backend/.env.
# Obtain a key at https://aistudio.google.com/apikey (never commit credentials).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
